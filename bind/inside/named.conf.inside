// Primary authoritative server for example.com, on the LOW (untrusted,
// internet-facing) side of the optical data diode.
//
// This is the authoritative source for the zone. It serves queries from
// the internet (or wherever the zone needs to be authoritative), and the
// ONLY thing that ever leaves this host toward the diode is the one-way
// UDP carousel produced by diode_tx/zone_diode_tx.py, derived from a
// *local* AXFR pulled over loopback (see the "txfr-local" key below).
//
// This configuration assumes the zone is sourced/maintained locally on
// this host (e.g., managed via RNDC or dynamically updated). If the zone
// is pulled from a remote trusted repository, adjust accordingly.

options {
    directory "/var/lib/bind/low";

    listen-on { any; };            // authoritative server, serves internet queries
    listen-on-v6 { any; };

    allow-query { any; };
    allow-transfer { none; };       // deny by default; overridden per-zone below
    allow-recursion { none; };
    recursion no;

    notify yes;                     // notify any real secondaries if configured
};

// Used solely so diode_tx can pull a real AXFR from this primary over
// 127.0.0.1. Never crosses the diode, never needs to be known outside this
// host. Generate with:  tsig-keygen txfr-local
key "txfr-local" {
    algorithm hmac-sha256;
    secret "REPLACE_WITH_OUTPUT_OF_tsig-keygen_txfr-local";
};

zone "example.com" {
    type primary;
    file "zones/db.example.com";
    allow-transfer { key "txfr-local"; };  // only the local diode-tx process, over loopback
    allow-update { none; };                // update via other means if needed, but not from network
};

// If the zone is DNSSEC-signed, sign it here (inline-signing or offline
// dnssec-signzone) so that only already-signed, already-canonicalized zone
// content is ever handed to diode_tx. The private KSK/ZSK material stays
// on the LOW side (which is fine, it's authoritative there anyway), and
// the HIGH-side replica only ever serves the static signed RRSIGs.
