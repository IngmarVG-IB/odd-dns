// Replica authoritative server for example.com, on the HIGH (trusted,
// air-gapped) side of the diode.
//
// zones/db.example.com is NOT hand-edited and NOT managed by any dynamic
// update or AXFR-pull mechanism on this host -- it is overwritten in place,
// atomically, exclusively by diode_rx/zone_diode_rx.py. From BIND's point
// of view this is a perfectly ordinary primary zone; it has no idea the
// data arrived over a one-way link, and it does not need to.
//
// This server is air-gapped and cannot reach the internet. It can serve
// queries from its own isolated network (e.g., internal servers that need
// to resolve example.com locally without exposing DNS queries to the internet).
// It does NOT serve the public internet -- the LOW side does.

options {
    directory "/var/lib/bind/high";

    listen-on { 127.0.0.1; };     // loopback and internal network only
    listen-on-v6 { none; };

    allow-query { localhost; };    // internal network only
    allow-transfer { none; };      // never AXFR this replica outward
    recursion no;

    notify no;                     // no secondaries downstream of this replica
};

zone "example.com" {
    type primary;
    file "zones/db.example.com";
    allow-update { none; };        // never accept updates -- zone_diode_rx.py owns this file exclusively
    notify no;                     // no downstream secondaries to notify
};
